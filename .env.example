# Salin file ini menjadi `.env.local` lalu isi key yang kamu punya.
# Key di sini HANYA dibaca server (tanpa awalan VITE_), tidak pernah dikirim ke browser.
# Jika dikosongkan, pengguna masih bisa memakai API key pribadi mereka sendiri.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opsional: OpenClaw lokal
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_API_KEY=
